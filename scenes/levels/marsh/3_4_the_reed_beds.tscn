entity_props = {
"1": {
"caption": "The outflow spat him out among reeds taller than houses: rolled paper, gone soft, standing up out of the ink in thickets.",
"size": Vector2(128, 384)
},
"2": {
"caption": "The reeds grew too thick to climb and too tall to see over. The only way on was under them, through the dark at their roots.",
"size": Vector2(128, 384)
},
"3": {
"caption": "Something had trampled the bank flat. There were feathers in the mud, long grey paper feathers, and they were wet.",
"size": Vector2(128, 384)
},
"4": {
"caption": "The Weir. The channel ran hard back towards him, and at its far end a shaft of ink welled up out of the dark towards the high bank.",
"size": Vector2(128, 384)
},
"5": {
"caption": "From the reed mat he could see the gates: one wheel by the bank swung the channel and the shaft together. This one only the shaft.",
"size": Vector2(128, 384)
},
"6": {
"caption": "The counting stalls, up on the high bank where the clerks had carried the ledgers when the water came. They hadn't carried them far enough.",
"size": Vector2(128, 384)
},
"7": {
"caption": "A drain ran under the last of the reeds. Beyond it the marsh opened out, black and flat, and something stood far off in it on one leg.",
"size": Vector2(128, 384)
},
"W": {
"channels": Array[Rect2]([Rect2(104, 8, 2160, 112), Rect2(2152, -504, 112, 496)])
},
