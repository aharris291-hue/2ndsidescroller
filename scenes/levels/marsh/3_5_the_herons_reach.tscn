entity_props = {
"1": {
"caption": "The Heron's Reach: the bottom of the marsh, where all the ink in the book had come to lie down.",
"size": Vector2(128, 384)
},
"2": {
"caption": "Islands of peat, and between them ink so still it showed the moon. A feather lay on it, and did not drift.",
"size": Vector2(128, 384)
},
"3": {
"caption": "On a post someone had nailed a page from the ledger. It was the flood night again. There was a heron printed in the margin, watching.",
"size": Vector2(128, 384)
},
"4": {
"caption": "The heron's larder: the bank was littered with what it had speared and left. Paper fish. Paper frogs. A paper fox's ear, not his.",
"size": Vector2(128, 384)
},
"5": {
"caption": "The black lake. Rings of old brass hung out over it from the dead trees, where the clerks had moored their boats.",
"size": Vector2(128, 384)
},
"6": {
"caption": "It stood on the far side, grey, enormous, perfectly still. It had been standing there the whole time.",
"size": Vector2(128, 384)
},
"7": {
"caption": "Through the reeds ahead, a clearing, and a nest the size of a room, woven out of torn ledgers.",
"size": Vector2(128, 384)
},
