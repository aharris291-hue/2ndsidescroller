[node name="TheHeronsReach" type="Node2D"]
script = ExtResource("1_page")
page_title = "The Heron's Reach"
opening_caption = "The Heron's Reach. Nothing moved on the ink. Nothing had moved on it for a long time."
music = ExtResource("2_music")
weather_tint = Color(0.34, 0.4, 0.42, 1)
rain_amount = 60

