entity_props = {
"1": {
"caption": "The ledger house had gone down by the stern. Its ground floor was a cellar of ink, and the clerks' desks stood in it to the drawers.",
"size": Vector2(128, 384)
},
"2": {
"caption": "Two channels ran under the counting room, one over the other, the top one flowing out and the bottom one flowing in. The house was breathing through them.",
"size": Vector2(128, 384)
},
"3": {
"caption": "The stacks. Every book the clerks ever kept, swollen to twice its size, and some of them had learned to open by themselves.",
"size": Vector2(128, 384)
},
"4": {
"caption": "A drain in the floor, pulling hard, down and then up into the dark of the shaft above. Whatever goes in comes out somewhere high.",
"size": Vector2(128, 384)
},
"5": {
"caption": "The top shelves, where the oldest ledgers were kept dry. Someone had written the names of everyone on the river in them, and a line through some.",
"size": Vector2(128, 384)
},
"6": {
"caption": "He found the page for the flood night. There was a line through Drizzle's name, in a hand he didn't know. He tore it out.",
"size": Vector2(128, 384)
},
"7": {
"caption": "Past the drain, a door marked SLUICE. Behind it, the sound of a great deal of ink waiting to be let go.",
"size": Vector2(128, 384)
},
"X": {
"size": Vector2(128, 256),
"target_page": "res://scenes/levels/marsh/3_1_the_sump_road.tscn",
"target_spawn": &"FromLedger"
},
