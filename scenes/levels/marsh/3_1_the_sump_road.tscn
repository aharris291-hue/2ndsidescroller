entity_props = {
"1": {
"caption": "Past the Spine the flood had nowhere left to run. It lay down in the low pages and settled, and the ink in it sank and stayed.",
"size": Vector2(128, 384)
},
"2": {
"caption": "The road went out over the sump on boards someone had laid in a hurry. Some of them were floating now. The ink underneath did not move at all.",
"size": Vector2(128, 384)
},
"3": {
"caption": "On the rise, the ink had dried into the paper in pale lines, the way a watermark sits in a banknote. Held against the dark, the lines made pictures.",
"size": Vector2(128, 384)
},
"4": {
"caption": "A wall of sodden card stood across the road with the ink banked up against it. Over the top was nothing to hold. Under it, the black went on.",
"size": Vector2(128, 384)
},
"5": {
"caption": "The road dropped into a cut where the ink lay deep and still. Things had sunk in it. Some of them were still sinking.",
"size": Vector2(128, 384)
},
"6": {
"caption": "Peat banks, black and soft. Something had been living out here since the flood, eating what washed up.",
"size": Vector2(128, 384)
},
"7": {
"caption": "A culvert under the road, with the ink sliding through it towards the low ground. It pulled at his whiskers even from the bank.",
"size": Vector2(128, 384)
},
"8": {
"caption": "Beyond the culvert, the ledger house: a counting office that had sunk to its sills, its windows full of ink.",
"size": Vector2(128, 384)
},
"B": {
"ability_id": &"blot_dive",
"offset": Vector2(0, -24),
"unlock_caption": "The watermark on the hill was the flood night. A small fox on the bank. A blue-grey shape going under. The fox not following. Patch stood in front of it a long time. Then he walked into the ink and let it close over him, and it did not kill him. Walk into the ink to Blot Dive: swim with the stick or keys, and {jump} at the surface to leap out. The ring is your breath. When it empties, the ink starts to take you."
},
"X": {
"size": Vector2(128, 256),
"target_page": "res://scenes/levels/hub/spine_hub.tscn",
"target_spawn": &"Start"
},
"E": {
