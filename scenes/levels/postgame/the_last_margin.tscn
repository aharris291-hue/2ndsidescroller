entity_props = {
"1": {
"caption": "The last page of the book: the blank one at the back, that Nell drew on at the table. From in here it wasn't blank at all. The ink from the Gutter had come up through it from underneath, the way damp comes up a wall.",
"size": Vector2(128, 384)
},
"2": {
"caption": "A pencil note in the margin, in Gran's hand, very small: Leave room at the back. Every book needs somewhere to put the things that didn't fit.",
"size": Vector2(128, 384)
},
"3": {
"caption": "Nell's crayon: a fox, a cloud, a sun with too many rays. And under it, in pen, pressed hard enough to tear the paper: IT'S RUINED. Crossed out. Written again. Crossed out again.",
"size": Vector2(128, 384)
},
"4": {
"caption": "From the top of the slate he could see the bottom of the margin. A long way down, and something standing on it, small and dark and fox-shaped, with its back to him.",
"size": Vector2(128, 384)
},
"5": {
"caption": "Footprints in the wet ink, the size of his own. All of them going one way: away.",
"size": Vector2(128, 384)
},
"6": {
"caption": "The bottom of the last page. The flood had stopped here, and left a tide line. Standing on it, with the shears in his paw, was the fox who ran.",
"size": Vector2(128, 384)
},
"O": {
"offset": Vector2(0, -64)
},
"X": {
"size": Vector2(128, 256),
"target_page": "res://scenes/levels/hub/spine_hub.tscn",
