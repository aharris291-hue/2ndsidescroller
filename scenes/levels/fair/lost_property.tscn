entity_props = {
"1": {
"caption": "Lost Property. Everything the crowd left behind when the water came, every piece ticketed and shelved in the Barker's best lettering: a pram with no wheels, a hundred odd gloves, a tin whistle, a programme somebody had folded into a paper boat, as if they'd known.",
"size": Vector2(128, 320)
},
"2": {
"caption": "On the top shelf, ticketed like the rest, a heart sewn from a ticket roll, kept for whoever came back to claim it. Nobody had come back. Patch took it, and he left the ticket where it was.",
"size": Vector2(128, 384)
},
