entity_props = {
"1": {
"caption": "The Gatefold Fair. Gran took Nell every summer, and every summer Nell made her stay till the lights went off. Nobody turned them off this time. The flood did.",
"size": Vector2(128, 384)
},
"2": {
"caption": "Something was still going round. It had come off the carousel with its pole through it and it went round on its own now, round and round the boards, looking for a rider.",
"size": Vector2(128, 384)
},
"3": {
"caption": "The ticket booth. Pinned inside the glass, among the old prices, a paper plane folded from the back page of a programme. Gran's folds. Nell's name on the wing, in Nell's writing, aged six.",
"size": Vector2(128, 384)
},
"4": {
"caption": "Where the boards had gone the fair went down and down into the dark, and somewhere a long way under it the organ was still playing.",
"size": Vector2(128, 384)
},
"5": {
"caption": "Warm air out of the vents, from the generators under the boards. Enough to lift a sheet of paper. Enough to lift a fox, folded right.",
"size": Vector2(128, 384)
},
"6": {
"caption": "From the roofs he could see the whole fair turning in the rain: the wheel, the helter-skelter, the big top with its lamps lit. All of it open. Nobody inside.",
"size": Vector2(128, 384)
},
"7": {
"caption": "The vent breathed. Stopped. Breathed. The whole fair did that now, like something asleep.",
"size": Vector2(128, 384)
},
"8": {
"caption": "A banner across the way to the wheel, painted fresh over the old one: ROLL UP. NOBODY LEAVES. EVERYBODY HAS A WONDERFUL TIME.",
"size": Vector2(128, 384)
},
"B": {
"ability_id": &"paper_plane",
"offset": Vector2(0, -24),
"unlock_caption": "Gran had folded it for Nell on the bus home, so she'd stop crying about the lights going off. Nose, wings, a crease down the middle. Patch folded himself the same way. Paper Plane Glide: hold {jump} while falling to glide. Warm air from the vents lifts a glider."
},
"X": {
"size": Vector2(128, 256),
"target_page": "res://scenes/levels/hub/spine_hub.tscn",
"target_spawn": &"Start"
},
"E": {
