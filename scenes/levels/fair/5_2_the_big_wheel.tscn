entity_props = {
"1": {
"caption": "The Big Wheel, still turning. The gondolas came down out of the rain one after another, empty, swung, and went back up.",
"size": Vector2(128, 384)
},
"2": {
"caption": "From the top of the wheel the helter-skelter was close enough to touch. Nearly.",
"size": Vector2(128, 384)
},
"3": {
"caption": "Somebody had been up here before him. Scratched into the lead of the helter-skelter's roof: D. + P. And under it, newer, deeper: YOU SAID YOU'D COME BACK.",
"size": Vector2(128, 384)
},
"4": {
"caption": "He read it again on the way down. He didn't want to, and he did.",
"size": Vector2(128, 384)
},
"X": {
"size": Vector2(128, 256),
"target_page": "res://scenes/levels/fair/5_1_the_midway.tscn",
