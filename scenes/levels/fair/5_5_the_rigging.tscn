entity_props = {
"1": {
"caption": "The big top, from outside: a hill of wet striped canvas, guyed down with ropes as thick as Patch. The doors were laced shut from the inside. Through the canvas, a voice, booming, cheerful, never stopping for breath.",
"size": Vector2(128, 384)
},
"2": {
"caption": "\"...ROLL UP, roll up, the greatest show in all the book, do NOT mind the weather, ladies and gentlemen, it's only a passing shower...\"",
"size": Vector2(128, 384)
},
"3": {
"caption": "The trapeze board. From up here you could see the whole fair, every light still on. And under the big top's skirts, all the way round, the black line where the water had come in and stayed.",
"size": Vector2(128, 384)
},
"4": {
"caption": "The lamp at the very top, and beside it a tear in the canvas, and light coming up out of it. And the voice: \"...and NOBODY leaves! Nobody leaves before the finale!\"",
"size": Vector2(128, 384)
},
"O": {
