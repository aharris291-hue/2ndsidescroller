entity_props = {
"1": {
"caption": "The Ghost Train. The painted mouth over the way in had lost its lower jaw to the water, so you went in under its teeth. Nell used to make Gran hold her hand the whole way round. Gran used to pretend to be more frightened than Nell.",
"size": Vector2(128, 384)
},
"2": {
"caption": "The cars still ran. Somebody had to have set them going, the night of the flood, and nobody had ever stopped them. One waited at the platform with its bar up.",
"size": Vector2(128, 384)
},
"3": {
"caption": "The middle station. A door marked LOST PROPERTY, and on it, in the Barker's best lettering: CLOSED UNTIL THE SHOW IS OVER.",
"size": Vector2(128, 384)
},
"4": {
"caption": "The second car went quicker, the way they always did in the dark part, so you'd scream. Things were waiting under the rail. They'd been waiting a long time for someone to scare.",
"size": Vector2(128, 384)
},
"5": {
"caption": "The end of the line, and the far platform, and past it, through a torn flap in the ride's back wall, the big top. Its lamp was lit. Somebody was talking in there. Somebody had never stopped.",
"size": Vector2(128, 384)
},
"D": {
"door_prompt": "Go into Lost Property",
"requires_flag": "boss_barker_defeated",
"target_page": "res://scenes/levels/fair/lost_property.tscn",
"target_spawn": &"Start"
},
"X": {
"size": Vector2(128, 256),
"target_page": "res://scenes/levels/fair/5_3_the_gatefold.tscn",
"target_spawn": &"Start"
},
"E": {
