entity_props = {
"1": {
"caption": "The chapel's back door let out onto the millrace. Somebody had cut it to drive the wheel. Now the whole flood came down it.",
"size": Vector2(128, 640)
},
"2": {
"caption": "Knee-deep, and pulling. Every step Patch took, the water tried to take back.",
"size": Vector2(128, 640)
},
"3": {
"caption": "Past the sluice, the race ran black and fast enough to carry a fox to the sea. The gate's winch was still on its post.",
"size": Vector2(128, 640)
},
"4": {
"caption": "The mill's old windmill still turned in the storm, seats and all. Nobody had told it to stop.",
"size": Vector2(128, 640)
},
"5": {
"caption": "The third sluice. Below it, under the water, something small and pale was caught in the weeds.",
"size": Vector2(128, 640)
},
"6": {
"caption": "The mill stood over the race like a man over a grave. Its door hung open.",
"size": Vector2(128, 640)
},
"7": {
"caption": "Inside, something huge was turning in the dark, and the stair went up around it.",
"size": Vector2(128, 640)
},
