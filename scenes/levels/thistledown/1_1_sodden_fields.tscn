entity_props = {
"1": {
"caption": "Thistledown had been a meadow. Now it was the bottom of something.",
"size": Vector2(128, 640)
},
"2": {
"caption": "It glinted before it lunged. {guard} just as the glint comes, and the lunge breaks on the shears.",
"size": Vector2(128, 640)
},
"3": {
"caption": "The paper had drunk the flood. It would hold him for a moment, no longer. And it was too soft to jump from: it just gave.",
"size": Vector2(128, 640)
},
"4": {
"caption": "Gran's market awnings still hung over the old stalls. Cut the rope, and the canvas would keep the rain off whatever lay under it.",
"size": Vector2(128, 640)
},
"5": {
"caption": "Under the field, a bell. A sheep's bell, still ringing, somewhere it shouldn't be.",
"size": Vector2(128, 640)
},
"6": {
"caption": "Moths, out of the folded corners of drowned pages. They came at him one at a time, as if they'd agreed to.",
"size": Vector2(128, 640)
},
"7": {
"caption": "Beyond the hedge, someone was shouting at sheep.",
"size": Vector2(128, 640)
},
"A": {
"cut_caption": "The canvas fell, and under it the paper began, slowly, to dry.",
"width": 224.0
},
