entity_props = {
"1": {
"caption": "Water came down through every floor of the mill, and the great gears were still turning in it.",
"size": Vector2(128, 640)
},
"2": {
"caption": "Something had been living on the first floor. It had heard him come in.",
"size": Vector2(128, 640)
},
"3": {
"caption": "The flour sacks hung between the beams, soaked through. They would hold him, for a moment.",
"size": Vector2(128, 640)
},
"4": {
"caption": "Halfway up, Patch could hear the wheel. Not the gears: the wheel, the big one, breathing.",
"size": Vector2(128, 640)
},
"5": {
"caption": "The top floor. Something folded itself up out of the dark, all neck and beak.",
"size": Vector2(128, 640)
},
"6": {
"caption": "Beyond the door, the mill floor, and the thing that turned it.",
"size": Vector2(128, 640)
},
