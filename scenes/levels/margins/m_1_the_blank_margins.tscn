entity_props = {
"1": {
"caption": "The margins. Gran never wrote in them; she said a book should be allowed to breathe. Out here the paper had been left blank so long it had forgotten it was ever meant for anything.",
"size": Vector2(128, 384)
},
"2": {
"caption": "Nothing between him and the next sheet but a long way down. Then the rain thickened, and where it fell on nothing, it wrote: a grey outline first, then a ledge of wet ink, for as long as it poured.",
"size": Vector2(128, 384)
},
"3": {
"caption": "Footprints on the blank paper, and not his. Something had come out here before him and not gone back. The rain had half washed them away.",
"size": Vector2(128, 384)
},
"4": {
"caption": "Someone had stuck a bookmark in the margin, a long way from any story. Patch didn't like to think who, or what they'd been waiting for.",
"size": Vector2(128, 384)
},
"5": {
"caption": "A wind off the edge of the book, steady as a hand pushing him back. The slate pillar was the only thing out here that didn't move. He waited for the next shower on it.",
"size": Vector2(128, 384)
},
"6": {
"caption": "Writing, at last, on the paper at his feet: one word, over and over, smaller and smaller, the way you write when your hand is shaking. CHANGE. CHANGE. CHANGE.",
"size": Vector2(128, 384)
},
"7": {
"caption": "The last of the margins, and over it the eye of the storm, turning, as if it had been waiting for someone to come out far enough.",
"size": Vector2(128, 384)
},
"E": {
"size": Vector2(128, 256),
"target_page": "res://scenes/levels/margins/the_forecast.tscn",
"target_spawn": &"Start"
},
