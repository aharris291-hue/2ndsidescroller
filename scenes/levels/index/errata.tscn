entity_props = {
"1": {
"caption": "The Errata: the slip pasted in at the back of a book to own up to what it got wrong. For 'shower' read 'flood'. For 'stayed in' read 'were left'. For 'he didn't hear' read 'he heard'. Every correction in a different hand.",
"size": Vector2(128, 320)
},
"2": {
"caption": "The last line was in Gran's hand, the ink gone brown: For 'lost' read 'kept'. Under it, sewn to the slip with red thread, a heart patch. Patch took it, and left the slip where it was, for the next reader.",
"size": Vector2(128, 384)
},
"X": {
"size": Vector2(128, 256),
"target_page": "res://scenes/levels/index/6_4_the_stacks.tscn",
