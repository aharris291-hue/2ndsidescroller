entity_props = {
"1": {
"caption": "The card catalogue: a cabinet so big it had weather inside it. Somewhere up in the dark, drawers were sliding in and out on their own, the way they would if someone were still looking something up.",
"size": Vector2(128, 384)
},
"2": {
"caption": "A drawer came out of the wall over his head, stayed, thought about it, and went back in. Then the next one up. Then the next. As if the whole cabinet were breathing.",
"size": Vector2(128, 384)
},
"3": {
"caption": "Half way up, a card had fallen out of a drawer into the dust: DRIZZLE, a dog of paper. See: the night of the flood. See: the window. See: who didn't come back.",
"size": Vector2(128, 384)
},
"4": {
"caption": "The top of the catalogue, and the way on shut behind another sprung shutter. Its tab was down the shaft. Of course it was.",
"size": Vector2(128, 384)
},
