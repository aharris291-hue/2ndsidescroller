entity_props = {
"1": {
"caption": "The Index. At the back of every book, after the story is over, the list of everything that was in it, filed by letter. Gran said you could tell what a book was really about by what it bothered to index.",
"size": Vector2(128, 384)
},
"2": {
"caption": "The floor moved. Not the floor: something under the top sheet of it, long, nosing along, the paper lifting in a ridge over its back. Silverfish. They had eaten their way in and grown fat on the words.",
"size": Vector2(128, 384)
},
"3": {
"caption": "A reading desk with a book left open on it, face down, the way Gran always told Nell not to leave a book. Gran's book. Her red ribbon was still in it, keeping the place she'd never get back to.",
"size": Vector2(128, 384)
},
"4": {
"caption": "A shaft between the stacks, with something glinting at the bottom. A long way down. A long way back up, unless he left something to come back to.",
"size": Vector2(128, 384)
},
"5": {
"caption": "A roll shutter over the way through, and up on the stacks a tab to work it, on a spring. Gran's voice, from a long time ago: you never lose your place if you leave a ribbon in it.",
"size": Vector2(128, 384)
},
"6": {
"caption": "Index entries, pinned to the stacks in rows. FLOOD, THE: see NIGHT, THAT. NIGHT, THAT: see DRIZZLE. DRIZZLE: see PATCH.",
"size": Vector2(128, 384)
},
"7": {
"caption": "Another shutter, another tab, and something long and pale waiting by the door, chewing. It had eaten the bottom off the shutter's label. It would eat a ribbon just the same.",
"size": Vector2(128, 384)
},
"8": {
"caption": "PATCH, the entry said. Fox, paper. Left a friend in the rain. See also: everything after.",
"size": Vector2(128, 384)
},
"B": {
"ability_id": &"bookmark_warp",
"offset": Vector2(0, -24),
"unlock_caption": "Gran's ribbon. Patch took it out of her book and the page it kept closed for good. Bookmark Warp: press {warp} on the ground to lay the ribbon where you stand; press {warp} again, anywhere on the page, to tear back to it. It's paper. Silverfish eat paper."
},
"P": {
"open_time": 1.6,
"size": Vector2(96, 384),
"tag": "P"
},
"Q": {
"open_time": 1.4,
"size": Vector2(96, 384),
"tag": "Q"
},
