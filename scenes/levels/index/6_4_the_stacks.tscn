entity_props = {
"1": {
"caption": "The Stacks. Shelves going up into the dark further than the lamps could reach, and every book on them gnawed. Somewhere ahead, very faint, a sound like someone crossing things out: a nib, scratching, steady, patient.",
"size": Vector2(128, 384)
},
"2": {
"caption": "The ink had got in here too, all the way from the Marsh, down the gutters of the book. The low shelves stood in it up to their chins. Under the surface the titles could still be read. Above it, someone had gone along and struck every one of them through.",
"size": Vector2(128, 384)
},
"3": {
"caption": "Drawers up the face of the shelving, sliding in and out like breath. At the top, a door with a slip of paper pasted over the keyhole: ERRATA. NOT TO BE OPENED UNTIL CORRECTED.",
"size": Vector2(128, 384)
},
"4": {
"caption": "From up here he could see the whole of the stacks, row on row, and in every row the same black bars. Not damage. Work. Somebody had been going through the Index a line at a time, deciding what the book was allowed to have been.",
"size": Vector2(128, 384)
},
"5": {
"caption": "Another spring shutter, and its tab at the bottom of the old book lift. Gran's ribbon was light in his paw. Somewhere to come back to.",
"size": Vector2(128, 384)
},
"6": {
"caption": "The entries here were struck out so hard the pen had gone through the page: FLOOD, THE. NIGHT, THAT. RAIN. WINDOW. Only the page numbers were left, like little black crosses.",
"size": Vector2(128, 384)
},
"7": {
"caption": "The struck-out lines went on ahead of him, fresher and fresher. On the last of them the ink was still wet. Whoever was doing it was close, and had got as far as P.",
"size": Vector2(128, 384)
},
"q": {
"cascade": 0.3,
"dir": -1.0
},
"P": {
"open_time": 2.0,
"size": Vector2(96, 384),
"tag": "P"
},
