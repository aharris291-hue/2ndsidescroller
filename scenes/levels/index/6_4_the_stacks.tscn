[node name="TheStacks" type="Node2D"]
script = ExtResource("1_page")
page_title = "The Stacks"
opening_caption = "The Stacks. Everything the book ever held, shelved, and struck out."
music = ExtResource("2_music")
weather_tint = Color(0.5, 0.46, 0.42, 1)
rain_amount = 90
