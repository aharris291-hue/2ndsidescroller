entity_props = {
"1": {
"caption": "The Gnawed Pages: the last leaves of the book, so eaten there was more hole than page. You could see the dark through them. Not the dark of a room. The dark of nothing, where the book stopped.",
"size": Vector2(128, 384)
},
"2": {
"caption": "Chewing. All round him, inside the paper, a sound like rain that hadn't decided to fall. Then it stopped, all of it at once, the way a room goes quiet when someone says your name.",
"size": Vector2(128, 384)
},
"3": {
"caption": "He didn't look back. He had done this before: run from something coming and not looked back. This time there was nobody behind him to leave.",
"size": Vector2(128, 384)
},
"4": {
"caption": "The shutter came down and the Gnawing hit it like surf. It chewed at the slats, and then it drew back into the dark, and the dark was quiet again. For now.",
"size": Vector2(128, 384)
},
"5": {
"caption": "Beyond the shutter, the last page of the book, and a sound coming from it that Patch knew now: a nib, scratching, steady, patient, striking things out. It had got to P.",
"size": Vector2(128, 384)
},
"q": {
