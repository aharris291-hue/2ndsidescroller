entity_props = {
"1": {
"caption": "The Reading Room, under the dome. Rain came through the skylight onto the desks. Shutters down over every alcove, and a tab by each to work them, and none of them worked only the one you wanted.",
"size": Vector2(128, 320)
},
"2": {
"caption": "Somebody had sat here a long time, sorting. Cards in piles: kept, kept, kept, and one pile on its own, turned face down. He didn't turn them over.",
"size": Vector2(128, 320)
},
"3": {
"caption": "Through. The desks went up like stairs towards the dome, each one with its lamp still lit, the way you'd leave a light on for somebody coming home late.",
"size": Vector2(128, 384)
},
"4": {
"caption": "At the top, a card pinned to the last desk, in Gran's hand: WHERE YOU LEFT OFF. Under it, a way on, deeper into the Index.",
"size": Vector2(128, 384)
},
"A": {
"size": Vector2(96, 384),
"tag": "A"
},
"B": {
"size": Vector2(96, 384),
"tag": "B"
},
