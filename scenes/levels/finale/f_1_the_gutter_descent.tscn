entity_props = {
"1": {
"dialogue_id": "gutter_arrival",
"size": Vector2(128, 384)
},
"2": {
"caption": "Wet footprints on the torn pages, small ones, going down. They stopped and started, as if whoever made them kept looking back to see if anyone was coming.",
"size": Vector2(128, 384)
},
"3": {
"caption": "Here the page came down to meet the ink, and the ink went on under it. Underneath, a current was still running the way the flood had run that night: down, and in, and away.",
"size": Vector2(128, 384)
},
"4": {
"caption": "The footprints again, and beside them, scratched into the pulp in a small hand, one word over and over. PATCH. PATCH. PATCH. Further on it stopped being his name and was only scratches.",
"size": Vector2(128, 384)
},
"5": {
"caption": "Another spring shutter, its tab down a shaft. Gran's ribbon was light in his paw. Somewhere to come back to. He was getting better at that. Coming back.",
"size": Vector2(128, 384)
},
"6": {
"caption": "The run-off had frozen where it fell, and things had frozen in it: Soggies, mid-step, all facing the same way. Down. Whatever was at the bottom had called them, and they had gone.",
"size": Vector2(128, 384)
},
"7": {
"caption": "The footprints stopped at the lip of the last fold. Below it there was no more page, only water, and the sound of something very large breathing under it. And from somewhere in the middle of it, very small, a knocking.",
"size": Vector2(128, 384)
},
"G": {
"clear_caption": "The gates sagged open. Down here nothing stayed beaten. It only sank, and waited to be called again.",
"height": 384.0,
"start_caption": "The gates swelled shut behind him, and the flood gave back what it had taken.",
"waves": PackedStringArray("sss", "sps", "mmK"),
"width": 22
},
"H": {
"clear_caption": "Quiet, and water running somewhere. The gates sagged open.",
"height": 384.0,
"start_caption": "Things that had drowned on every page of the book came up out of the dark: tacks and wings and painted horses, all of them soaked through.",
"waves": PackedStringArray("kk", "cbs", "hS", "Pmmc"),
"width": 22
},
"J": {
"clear_caption": "The gates opened, and the flood went still, as if it were listening.",
"height": 384.0,
"start_caption": "The last of them. Everything the book had lost, standing between Patch and the bottom of it.",
"waves": PackedStringArray("sSiI", "kKbh", "cCpP", "SKHB"),
"width": 18
},
"P": {
"open_time": 2.0,
"size": Vector2(96, 384),
"tag": "P"
},
