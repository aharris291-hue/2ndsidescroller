entity_props = {
"1": {
"caption": "The Fold Works. Somebody had kept this mountain on a schedule: rails strung between the peaks, and a sound like a clock going wrong.",
"size": Vector2(128, 384)
},
"2": {
"caption": "A sewing machine the size of a cart, hung from a rail, running back and forth over the snow. Every so often it stopped, and shook, and drove its pin down into whatever was under it.",
"size": Vector2(128, 384)
},
"3": {
"caption": "They'd been sewing the paper down, he realised. Every fold on the mountain stitched flat, so the flood couldn't lift it. Somebody had been very afraid of the water.",
"size": Vector2(128, 384)
},
"4": {
"caption": "Tacks, frost, wet paper. The Sogg's things had got up here anyway.",
"size": Vector2(128, 384)
},
"5": {
"caption": "A stair of folds, one peak standing on the last. Whoever built it meant it to be climbed by someone who knew how.",
"size": Vector2(128, 384)
},
"6": {
"caption": "A bench at the top, under an iron lamp gone cold. A name burned into the wood: BINDWELL. Patterns pinned all over it, and one of them was a frog.",
"size": Vector2(128, 384)
},
"7": {
"caption": "Bindwell's note on the frog pattern: Fold small. Fold smaller. Then let go. Under it, in the same hand, smaller: I SEWED THE SPINE SHUT. I HEARD THEM KNOCKING AND I DID NOT OPEN IT.",
"size": Vector2(128, 384)
},
"8": {
"caption": "From the top ledge he could see down the whole spine of the book: the Marsh, the harbour, the drowned fields, all of it below. Up here had stayed dry. Somebody had made sure.",
"size": Vector2(128, 384)
},
"B": {
"ability_id": &"frog_fold",
"offset": Vector2(0, -24),
"unlock_caption": "A paper frog: the oldest fold there is. Patch folded himself down small, smaller, and let go, and the snow fell away under him. Frog Fold: stand still and hold down until you fold flat, then jump. You spring about five tiles."
},
"N": {
"max_drop": 640.0,
"rail_left": -384.0,
"rail_right": 384.0,
"speed": 150.0
},
