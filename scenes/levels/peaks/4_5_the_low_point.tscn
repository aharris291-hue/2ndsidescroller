entity_props = {
"1": {
"caption": "Over the top of the spine the snow came sideways, and the wind came with it, and both of them were against him.",
"size": Vector2(128, 384)
},
"2": {
"caption": "Out of the blizzard, shapes. Soggies, a knight, a moth, one of the needles still sewing. The Sogg's things, as close to the top as they could get. As close to her.",
"size": Vector2(128, 384)
},
"3": {
"dialogue_id": "peaks_lowpoint",
"sets_flag": "patch_told_truth",
"size": Vector2(192, 384)
},
"4": {
"caption": "Above them, at the very top of the book, the sky was the colour of ink. Something up there was waiting for him. It had been waiting since the flood.",
"size": Vector2(128, 384)
},
