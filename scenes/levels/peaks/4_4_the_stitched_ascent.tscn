entity_props = {
"1": {
"caption": "The face of the spine went straight up into the snow, and all of it was stitched: long seams of red thread, pulled so tight the paper had puckered round them.",
"size": Vector2(128, 384)
},
"2": {
"caption": "A shelf of black ice, and the wind coming down it. Not a gust. A breath, from somewhere at the top, let out slow.",
"size": Vector2(128, 384)
},
"3": {
"caption": "A chimney in the binding, with planks hammered across it for a ladder. Somebody had come up and down here every night for years.",
"size": Vector2(128, 384)
},
"4": {
"caption": "Soggies on the ice up here too, frozen where they'd climbed. They'd been trying to get to the top. Somebody hadn't let them.",
"size": Vector2(128, 384)
},
"5": {
"caption": "Another of the machines, still running its rail. Beyond it a fold mark, and a cliff, and over the cliff a light in a window.",
"size": Vector2(128, 384)
},
"6": {
"caption": "Rimed and wet and hungry. They had been waiting at his door a long time.",
"size": Vector2(128, 384)
},
"7": {
"caption": "A door in the cliff, sewn shut. Not locked: sewn, edge to edge, with stitches so small and tight it might have been done with an eyelash. Whatever was in there, he meant it to stay in.",
"size": Vector2(128, 384)
},
"8": {
"caption": "The workshop. A lamp lit, a stove gone out, and the sound inside of somebody sewing very fast, as if they could hear him coming.",
"size": Vector2(128, 384)
},
"G": {
"blow_time": 2.2,
"rest_time": 2.0,
"size": Vector2(1280, 448),
"snow": true,
"strength": -500.0
},
