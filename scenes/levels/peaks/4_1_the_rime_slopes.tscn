entity_props = {
"1": {
"caption": "Above the Marsh the book's spine stood up into the cold, and the pages there had folded themselves into mountains. Nothing up here was wet. Everything was frozen.",
"size": Vector2(128, 384)
},
"2": {
"caption": "Black ice over the slate. It had been the flood once. Up here it never got the chance to drown anything. It just stopped, and waited.",
"size": Vector2(128, 384)
},
"3": {
"caption": "The wind came down off the spine in long breaths. Each one meant it.",
"size": Vector2(128, 384)
},
"4": {
"caption": "Soggies, rimed white. The frost had got into them and set like armour. The shears would only skid. Something heavier, then. Something from above.",
"size": Vector2(128, 384)
},
"5": {
"caption": "The snow gave under him. Not much. Just enough.",
"size": Vector2(128, 384)
},
"6": {
"caption": "A page frozen solid, with him inside it. Pinned in the ice in front of him was one of Gran's patterns: a pop-up, perfect, every fold marked. He knew how it went. She'd made him watch her do it a hundred times.",
"size": Vector2(128, 384)
},
"7": {
"caption": "A fold mark in the snow, printed and waiting. Somebody had left the whole mountain like this, ready to stand up when it was told.",
"size": Vector2(128, 384)
},
"8": {
"caption": "The ice field. Three of them, rimed and patient, standing on the black ice as if they'd been put there.",
"size": Vector2(128, 384)
},
"B": {
"ability_id": &"pop_up_slam",
"offset": Vector2(0, -24),
"unlock_caption": "Gran's pop-up pattern. Fold, fold, crease, and stamp it down hard, and the whole thing jumps up off the page. Patch stamped. The ice in front of him cracked from end to end. Pop-Up Slam: {slam} (or attack while holding down in mid-air). It cracks ice, springs fold marks, and breaks the frost on a rimed Soggy."
},
"G": {
"blow_time": 2.4,
"rest_time": 2.2,
"size": Vector2(1280, 640),
"snow": true,
"strength": -540.0
},
"H": {
