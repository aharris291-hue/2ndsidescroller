entity_props = {
"1": {
"caption": "Bindwell's pattern room. Four folds in the floor, short to tall, and every one pinned to the ones beside it with red thread. Stamp one and its neighbours jump too. The way on was a ledge only the tallest could reach.",
"size": Vector2(128, 320)
},
"2": {
"caption": "On the ledge, steps cut up into the snow, and a draught coming down them from the very top of the spine. Higher still, a lamp was burning in a workshop window. Somebody was awake up there.",
"size": Vector2(128, 384)
},
