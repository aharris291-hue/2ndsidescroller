entity_props = {
"1": {
"caption": "Two girls in their father's oilskins were waiting under the last lamp, a ladder between them and a box of wicks.",
"size": Vector2(128, 384)
},
"2": {
"caption": "Light the cold lamp, and the shadows of the slung boards fall across the shed wall, sharp enough to stand on. Let it go out and they are only shadows again.",
"size": Vector2(128, 384)
},
"3": {
"caption": "The wind came off the sea in bursts, shoving everything loose along the boards. Paper scraps flew ahead of each one, like a warning.",
"size": Vector2(128, 384)
},
"4": {
"caption": "This lamp was trimmed short. It would burn for a breath or two once he left it, no longer.",
"size": Vector2(128, 384)
},
"5": {
"caption": "The crane yard. Crates hung on ropes over the black water, and their shadows lay across it like a bridge, if there was light to make them.",
"size": Vector2(128, 384)
},
"6": {
"caption": "A net shed with its door hanging off, and a lantern burning inside, and something big and square sitting very still in the corner.",
"size": Vector2(128, 384)
},
"7": {
"caption": "The harbor flap lay at the end of the wharf, a great sodden sheet of card with the sea going in and out under it.",
"size": Vector2(128, 384)
},
"8": {
"caption": "Under the flap, something breathed. The whole flap rose and fell with it.",
"size": Vector2(128, 384)
},
"E": {
