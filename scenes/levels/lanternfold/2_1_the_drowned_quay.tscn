entity_props = {
"1": {
"caption": "One lamp was still burning at the end of the quay. Patch stood in it for longer than he needed to.",
"size": Vector2(128, 640)
},
"2": {
"caption": "Between the lamps it was black. Things moved in the black, and stopped at the edge of the light, and waited.",
"size": Vector2(128, 640)
},
"3": {
"caption": "The lamplighter's handcart lay on its side in the mud: ladder, oil can, wicks in a tin. No lamplighter.",
"size": Vector2(128, 640)
},
"4": {
"caption": "A cardboard boat, tied up neat, with CORRUGATE painted on the bow in a careful hand. Nobody aboard. A tin bowl on the deck, licked clean.",
"size": Vector2(128, 640)
},
"5": {
"caption": "The lamps down this street had been trimmed short. They'd burn a little while after you'd gone, and then they'd go out, whoever was still out there.",
"size": Vector2(128, 640)
},
"6": {
"caption": "Something clanked in the dark ahead. It didn't stop at the light. Tacks don't mind light.",
"size": Vector2(128, 640)
},
"7": {
"caption": "The harbour mouth. Lanterns on both sides of it, both cold, and the dark between them full.",
"size": Vector2(128, 640)
},
"8": {
"caption": "A corner of the page had folded over in the wet. Through the gap: a lamp, a real one, and the edge of Gran's table.",
"size": Vector2(128, 640)
},
"9": {
"caption": "The mole ran out to the lighthouse. Its light had gone out the night of the flood. The keeper hadn't come down.",
"size": Vector2(128, 640)
},
"E": {
"size": Vector2(192, 384),
"target_page": "res://scenes/levels/lanternfold/2_2_the_lamplighters_climb.tscn",
