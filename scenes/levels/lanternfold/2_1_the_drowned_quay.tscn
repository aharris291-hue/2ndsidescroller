[node name="TheDrownedQuay" type="Node2D"]
script = ExtResource("1_page")
page_title = "The Drowned Quay"
opening_caption = "Lanternfold had been a town of lamps. Somebody had gone round every night and lit them. Nobody had, since the flood."
music = ExtResource("2_music")
weather_tint = Color(0.4, 0.44, 0.56, 1)
rain_amount = 380

