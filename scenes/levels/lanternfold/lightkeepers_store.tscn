entity_props = {
"1": {
"caption": "No Bookmark down here. Only the keeper's short lamps, trimmed to burn a breath at a time, so a man could see the next shelf and no more.",
"size": Vector2(128, 384)
},
"2": {
"caption": "At the end, the keeper's own corner: a cot, a mug, a tin, and a patch of good cloth folded on the blanket as if he meant to come back for it.",
"size": Vector2(128, 384)
},
"3": {
"caption": "The tin was full of Scraps, saved a few at a time for years. On the lid, in the same careful hand: FOR THE GIRLS. Patch put it back. Then he took it, and promised himself he'd make it right.",
"size": Vector2(128, 384)
},
