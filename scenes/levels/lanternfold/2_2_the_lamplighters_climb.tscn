entity_props = {
"1": {
"caption": "The keeper's door had been left open. A burning lamp at the foot of the stair, and nothing at the top but dark.",
"size": Vector2(128, 384)
},
"2": {
"caption": "The first landing. Two cold lamps, and the dark between them crowded.",
"size": Vector2(128, 384)
},
"3": {
"caption": "On the landing, a lamplighter's coat, folded, and on top of it a roll of tape and a note in a careful hand: FOR THE GIRLS. The window beside it was gone, frame and all, as if the sea had reached in and taken what it wanted.",
"size": Vector2(128, 384)
},
"4": {
"caption": "Up here the wind came straight through the tower. Things with wings rode it.",
"size": Vector2(128, 384)
},
"5": {
"caption": "Far below, two small lights moved along the quay, stopping at each post. The lamplighter's daughters, still doing their father's rounds.",
"size": Vector2(128, 384)
},
"6": {
"caption": "The lamp room door. Something in there was still turning, slowly, on its own.",
"size": Vector2(128, 384)
},
"E": {
"size": Vector2(128, 256),
"target_page": "res://scenes/levels/lanternfold/2_3_the_lamp_room.tscn",
"target_spawn": &"Start"
},
